# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-opus-4-8)
# ARCHITECT_MODEL=claude-opus-4-8

# Optional: thinking effort — low | medium | high | xhigh | max (defaults to high)
# ARCHITECT_EFFORT=high
